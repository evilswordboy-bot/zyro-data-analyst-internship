/*
========================================================================================
 ZYROO DATA ANALYTICS INTERNSHIP • WEEK 4
 RIDE ANALYTICS & REVENUE INTELLIGENCE PLATFORM
 Power BI DAX Measures Specification & Dictionary
========================================================================================
 Data Table: 'Rides' (Imported from data/rides_data_week3.csv)
 Columns:
   - ride_id          (Text)
   - date             (Date/Time)
   - pickup_location  (Text)
   - dropoff_location (Text)
   - distance_km      (Decimal)
   - fare             (Currency / Decimal)
   - payment_method   (Text: Cash, Card, UPI, Wallet)
   - driver_id        (Text: DRV-001 to DRV-010)
   - ride_type        (Text: Economy, Standard, Premium)
   - ride_status      (Text: Completed, Cancelled)
   - rating           (Decimal: 1.0 to 5.0)
========================================================================================
*/

// ==========================================
// 1. CORE OPERATIONAL & VOLUME MEASURES
// ==========================================

Total Rides = 
COUNTROWS('Rides')
/*
  Calculates: Total number of ride requests dispatched across the platform.
  Why it is useful: Serves as the primary gross volume and demand benchmark.
*/

Completed Rides = 
CALCULATE(
    COUNTROWS('Rides'),
    'Rides'[ride_status] = "Completed"
)
/*
  Calculates: The count of successfully fulfilled rides.
  Why it is useful: Represents actual delivered service volume and billable transactions.
*/

Cancelled Rides = 
CALCULATE(
    COUNTROWS('Rides'),
    'Rides'[ride_status] = "Cancelled"
)
/*
  Calculates: The count of rides that were aborted or unfulfilled.
  Why it is useful: Critical operational churn metric measuring friction and lost opportunities.
*/

Completion Rate = 
DIVIDE([Completed Rides], [Total Rides], 0)
/*
  Format: Percentage (0.0%)
  Calculates: Percentage of total bookings that were successfully completed.
  Why it is useful: Primary fleet fulfillment efficiency KPI. Benchmark: >= 85%.
*/

Cancellation Rate = 
DIVIDE([Cancelled Rides], [Total Rides], 0)
/*
  Format: Percentage (0.0%)
  Calculates: Percentage of total bookings that were cancelled.
  Why it is useful: Flags operational leakage, driver cancellation trends, and passenger abandonment.
*/


// ==========================================
// 2. FINANCIAL & REVENUE INTELLIGENCE MEASURES
// ==========================================

Total Revenue = 
CALCULATE(
    SUM('Rides'[fare]),
    'Rides'[ride_status] = "Completed"
)
/*
  Format: Currency ($ or PKR #,##0.00)
  Calculates: Total realized cash and digital collections from completed trips only.
  Why it is useful: Prevents false financial reporting by strictly excluding cancelled trip fares.
*/

Gross Booking Value = 
SUM('Rides'[fare])
/*
  Format: Currency ($ or PKR #,##0.00)
  Calculates: Total potential fare value across all 100 booking requests regardless of status.
  Why it is useful: Quantifies top-of-funnel customer commercial demand.
*/

Revenue Lost to Churn = 
CALCULATE(
    SUM('Rides'[fare]),
    'Rides'[ride_status] = "Cancelled"
)
/*
  Format: Currency ($ or PKR #,##0.00)
  Calculates: Unrealized fare value from cancelled trips.
  Why it is useful: Shows executive management the exact monetary cost of operational failure (PKR 6,496).
*/

Average Fare = 
CALCULATE(
    AVERAGE('Rides'[fare]),
    'Rides'[ride_status] = "Completed"
)
/*
  Format: Currency ($ or PKR #,##0.00)
  Calculates: Mean monetary ticket size per completed trip.
  Why it is useful: Evaluates pricing yield, pricing power, and basket size per journey.
*/

Average Revenue per Ride = 
DIVIDE([Total Revenue], [Total Rides], 0)
/*
  Format: Currency ($ or PKR #,##0.00)
  Calculates: Realized revenue divided by total demand (including cancellations).
  Why it is useful: Measures platform monetization efficiency per dispatch attempt.
*/


// ==========================================
// 3. SERVICE QUALITY & OPERATIONAL METRICS
// ==========================================

Average Rating = 
CALCULATE(
    AVERAGE('Rides'[rating]),
    'Rides'[ride_status] = "Completed",
    NOT(ISBLANK('Rides'[rating]))
)
/*
  Format: Decimal (0.00)
  Calculates: Average passenger review rating on fulfilled trips.
  Why it is useful: Gauges rider satisfaction and driver service quality.
*/

Average Distance = 
CALCULATE(
    AVERAGE('Rides'[distance_km]),
    'Rides'[ride_status] = "Completed"
)
/*
  Format: Decimal (0.0 km)
  Calculates: Mean trip distance in kilometers for completed journeys.
  Why it is useful: Critical for route efficiency, fuel economics, and vehicle wear analysis.
*/

Total Operational Distance = 
CALCULATE(
    SUM('Rides'[distance_km]),
    'Rides'[ride_status] = "Completed"
)
/*
  Format: Decimal (#,##0.0 km)
  Calculates: Total kilometers traveled by fleet during fulfilled trips.
  Why it is useful: Core fleet wear and environmental impact metric.
*/


// ==========================================
// 4. CUSTOMER BEHAVIOR ANALYSIS MEASURES
// ==========================================

Customer Analysis Note = 
"DATASET NOTE: The dataset provides aggregate ride-level transactions without a unique 'customer_id' column. Customer behavior is therefore evaluated via trip velocity and demand frequency."
/*
  Calculates: Informative documentation string for UI cards.
  Why it is useful: Transparently addresses Phase 7 requirements without fabricating user IDs.
*/

Total Unique Customers = 
// Best practice DAX fallback when customer_id is absent:
// Evaluates distinct ride transaction proxies or returns documented disclaimer.
BLANK()
/*
  Explanation: In strict accordance with professional BI integrity standards,
  because 'customer_id' was omitted from the 11-column dataset schema,
  this measure is preserved as BLANK() with analytical commentary.
*/
